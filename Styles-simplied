/* ARREGLA EL ESPACIO FANTASMA */
.image-container > div {
  position: absolute;
}
.image-container,
.fade-container {
  line-height: 0;
  font-size: 0;
}
.image-container img,
.fade-container img {
  display: block;
}
/* ARREGLA EL ESPACIO FANTASMA */




/* INICIO DEL APARTADO PARA LA IMAGEN DE FONDO */
.image-container {
  position: relative;
  top: 0;
  left: 0;
  background: transparent;
  display: block;
  width: 100%;
  height: auto;
  z-index: 1; /* Debajo del fade */
}
.image-container img {
  position: relative;
  width: 100%;
  height: auto;
}
/* FIN DEL APARTADO PARA LA IMAGEN DE FONDO */




/* INICIO DEL APARTADO PARA EL FADE DE FONDO */
.fade-container {
  position: absolute;
  top: 0;
  left: 0;
  background: transparent;
  display: none;
  width: 100%;
  height: auto;
  opacity: 0;
  transition: opacity 1s ease-in-out;
  z-index: 2;
}
.fade-container img {
  width: 100%;
  height: auto;
}
/* FIN DEL APARTADO PARA EL FADE DE FONDO */




/* INICIO DEL APARTADO PARA LA FOTO NEON */
.neon-container,
.font-container,
.horizontal-container {
  justify-content: center;
  align-items: center;
  background-color: transparent;
  display: flex;
}
.neon-container svg,
.font-container svg,
.horizontal-container svg,
.necklace-container svg,
.left-heart-container svg,
.right-heart-container svg,
.vertical-container svg,
.IloveU-container svg,
.IwantU-container svg,
.you-container svg,
.kitty-container svg,
.melody-container svg,
.mine-container svg,
.left-star-container svg,
.right-star-container svg {
  width: 100%;
  height: auto;
}
.neon-container {
  position: absolute;
  top: 12%;
  left: 50%;
  transform: translateX(-50%);
  width: 57%;
  height: auto;
}
.neon-container svg path {
  fill:;
  stroke: #ff00ff;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
  filter: drop-shadow(0 0 10px #ff6ec7);
}
@keyframes neon-glow {
  0% { stroke-opacity: 1; }
  50% { stroke-opacity: 0.5; }
  100% { stroke-opacity: 1; }
}
.neon-container svg path {
  animation: neon-glow 1s infinite alternate;
}
/* FIN DEL APARTADO PARA LA FOTO NEON */




/* INICIO DEL APARTADO PARA EL FONT NAME */
